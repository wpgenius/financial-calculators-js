{
  "name": "@wpgenius/financial-calculators",
  "version": "1.1.1",
  "description": "Financial calculators in plain JavaScript with no dependencies: SIP, lump sum, SWP, goal and EMI, Indian and international number formatting, and amounts in words.",
  "keywords": [
    "finance",
    "calculator",
    "sip",
    "emi",
    "swp",
    "lumpsum",
    "indian-number-format",
    "number-to-words"
  ],
  "homepage": "https://wpgenius.github.io/financial-calculators-js/",
  "bugs": "https://github.com/wpgenius/financial-calculators-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpgenius/financial-calculators-js.git"
  },
  "license": "MIT",
  "author": "Team WPGenius (https://wpgenius.in)",
  "type": "module",
  "main": "./dist/financial-calculators.cjs",
  "module": "./dist/financial-calculators.esm.js",
  "unpkg": "./dist/financial-calculators.min.js",
  "jsdelivr": "./dist/financial-calculators.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./types/financial-calculators.d.ts",
        "default": "./dist/financial-calculators.esm.js"
      },
      "require": {
        "types": "./dist/financial-calculators.d.cts",
        "default": "./dist/financial-calculators.cjs"
      },
      "default": "./dist/financial-calculators.esm.js"
    },
    "./src": "./src/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "test:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "site": "node scripts/site.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "types": "./types/financial-calculators.d.ts"
}
